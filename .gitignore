# Data and model artifacts are regenerated by `make all` (PLAN §3.7, §8).
/data/
/models/*
!/models/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Local environment
.env

# Temporary files from atomic writes (PLAN §9.4)
*.tmp
