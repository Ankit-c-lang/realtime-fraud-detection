# Copy to .env and adjust. Compose reads .env via env_file (PLAN §12.2).

# Host-side value. Compose overrides REDIS_URL, DATA_DIR, MODEL_DIR and API_URL in the
# x-app `environment:` block, so this file stays correct for `make backfill`,
# `make test-redis` and the replayer while containers get the service-network names.
REDIS_URL=redis://localhost:6379/0

# Storage roots (PLAN §3.7). Inside the image these are /app/data and /app/models.
DATA_DIR=./data
MODEL_DIR=./models

# Leave unset to use the version named by models/CURRENT (PLAN §8).
MODEL_VERSION=v1

# Scorer consumer name within the "scorers" group (PLAN §9.2).
CONSUMER_NAME=scorer-1

# Where the dashboard reaches the API (PLAN §11). Inside Compose this is http://api:8000.
API_URL=http://localhost:8000

# Replayer clock multiplier: 3600 means one simulated hour per real second (PLAN §9.1).
SPEEDUP=3600
