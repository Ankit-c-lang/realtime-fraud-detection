# Copy to .env and adjust. Compose reads .env via env_file (PLAN §12.2).

# redis://localhost:6379/0 for host-side commands; redis://redis:6379/0 inside Compose.
REDIS_URL=redis://localhost:6379/0

# Storage roots (PLAN §3.7). Inside the image these are /app/data and /app/models.
DATA_DIR=./data
MODEL_DIR=./models

# Leave unset to use the version named by models/CURRENT (PLAN §8).
MODEL_VERSION=v1

# Scorer consumer name within the "scorers" group (PLAN §9.2).
CONSUMER_NAME=scorer-1

# Replayer clock multiplier: 3600 means one simulated hour per real second (PLAN §9.1).
SPEEDUP=3600
